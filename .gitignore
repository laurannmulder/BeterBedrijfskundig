# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example bevat geen geheimen en hoort wél in git, als sjabloon)
.env*
!.env.example

# vercel
.vercel

# echte cliëntdocumenten die soms tijdelijk in de projectmap belanden (bv. als
# voorbeeld voor het rapportagesjabloon, of testmateriaal) — mogen nooit
# gecommit worden
*.docx
*.pdf
*.eml

# typescript
*.tsbuildinfo
next-env.d.ts
