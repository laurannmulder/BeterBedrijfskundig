# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Schakelt Next.js' anonieme CLI-telemetrie (build/dev-statistieken naar Vercel) uit.
# Bevat geen documentinhoud, maar bij een privacygevoelige app als deze is "geen
# enkel extern verkeer dat niet strikt nodig is" de juiste default.
NEXT_TELEMETRY_DISABLED=1

# Supabase (zaken, documentmetadata, gebruikers, auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude API voor rapportgeneratie)
ANTHROPIC_API_KEY=

# OpenAI (Whisper — transcriptie van opgenomen gespreksopnames). Claude zelf
# ondersteunt geen audio-invoer, vandaar deze tweede leverancier, bewust
# geïsoleerd in src/lib/gesprekken/transcribeer.ts.
OPENAI_API_KEY=

# --- Hieronder: nog niet actief gebruikt ---
# Auth.js — voor later, zodra automatisch ophalen uit Microsoft weer opgepakt wordt.
AUTH_SECRET=

# Microsoft Entra ID (SSO + Microsoft Graph toegang tot SharePoint/OneDrive)
# App-registratie in Azure Portal > Entra ID > App registrations
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
